# Settings of the local copy on this Mac (http://127.0.0.1:8765).
#
# The local app has no .env file: it runs on the defaults built into trackfund/config.py, and every value below is that
# default. This file only writes them down. Nothing reads it automatically (docker compose reads .env, not .env.local),
# and it holds no passwords or keys.
#
# Started with:
#   cd ~/Downloads/repo/app && PYTHONPATH=. .venv/bin/uvicorn trackfund.api:app --host 127.0.0.1 --port 8765

# Where the database, uploaded files and generated reports live
TRACKFUND_DATA_DIR=/Users/himanshusharma/Downloads/repo/app/data
DATABASE_URL=sqlite:////Users/himanshusharma/Downloads/repo/app/data/trackfund.db
TRACKFUND_STORAGE_DIR=/Users/himanshusharma/Downloads/repo/app/data/storage

# Signs login cookies. Not set, so the app generated one on first start and keeps it in data/.secret_key
TRACKFUND_SECRET_KEY=

# Password given to every user created on first start. Not set, so a random one was generated and written to
# data/initial_credentials.txt (users who changed their password no longer use it)
TRACKFUND_INITIAL_PASSWORD=

# false locally because the Mac copy runs on plain http; must be true on the server (HTTPS)
TRACKFUND_COOKIE_SECURE=false

# Limits
TRACKFUND_MAX_UPLOAD_MB=300
TRACKFUND_MAX_FILES=2000
TRACKFUND_SESSION_HOURS=12
# Seconds the upload window's staged progress bar runs for a zip (0 = show the result as soon as it is ready)
TRACKFUND_UPLOAD_PROGRESS_SECONDS=20

# Organisation details loaded once into the database on first start (users come from seed/users.json)
TRACKFUND_SEED_PROFILE=/Users/himanshusharma/Downloads/repo/app/seed/org_profile.json
