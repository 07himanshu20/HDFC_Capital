# Copy to .env and fill in. Never commit .env.

# Postgres password used by docker-compose (database and app)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
# If unset, one is generated and kept in the data volume.
TRACKFUND_SECRET_KEY=

# Password given to every user created on first start (see seed/users.json).
# If unset, a random one is written to /data/initial_credentials.txt inside the app volume.
TRACKFUND_INITIAL_PASSWORD=

# Set to true when the app is served over HTTPS (it should be, behind your reverse proxy)
TRACKFUND_COOKIE_SECURE=false

# Limits
TRACKFUND_MAX_UPLOAD_MB=300
TRACKFUND_SESSION_HOURS=12
TRACKFUND_PORT=8000

# Local development without Docker uses SQLite in ./data unless DATABASE_URL is set, e.g.
# DATABASE_URL=postgresql+psycopg2://trackfund:password@localhost:5432/trackfund
